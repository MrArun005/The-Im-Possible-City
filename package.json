{
  "name": "im-possible-city",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "The I'm Possible 3D City - a cinematic, walkable, district-based city in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "budget": "node scripts/check-budgets.mjs",
    "decoders": "node scripts/copy-decoders.mjs",
    "verify": "npm run build && npm run budget",
    "render": "npm run build && node scripts/render-report.mjs",
    "artifact": "node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "@pmndrs/assets": "^1.7.0",
    "@sparkjsdev/spark": "^2.1.0",
    "gsap": "^3.13.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "vite": "^7.0.0",
    "vite-plugin-glsl": "^1.6.1"
  }
}
